/* USER CODE BEGIN 1 */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){
	static uint32_t last_millis=0;
	if(HAL_GetTick()- last_millis <=200){
		return;
	}
	last_millis=HAL_GetTick();
	button++;

	//evitato il debounce
	//adesso se premo start si avvia il timer
	if(GPIO_Pin == START_Pin){
		HAL_TIM_Base_Start_IT(&htim6);
		//avvio il timer 6
	}
	if (GPIO_Pin == STOP_Pin) {
		HAL_TIM_Base_Stop_DMA(&htim6);
		//stop il timer 6
	}
	if (GPIO_Pin == CHANGE_Pin) {
		//cambio freq_request
		switch (freq_request) {
			case 1:
				freq_request=1;
				break;
			case 2;
				freq_request=2;
				break;
			case 3;
				freq_request=1;
				break;
			default:
				break;
		}
		if(freq_request!=0){
			//c'è stata una richiesta e la inserisco nella coda
			queue_enqueue(&my_queue,&freq_request);
		}
	}

}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim){
	if(htim->Instance==TIM6){
		if (queue_extract(&my_queue, &request_extracted) == QUEUE_OK) {
			switch (request_extracted) {
			case (1):
				//imposto freq a 1hz
				__HAL_TIM_SET_AUTORELOAD(&htim7, 499);
				break;
			case (2):
				__HAL_TIM_SET_AUTORELOAD(&htim7, 249);
				break;
			case (3):
				__HAL_TIM_SET_AUTORELOAD(&htim7, 124);
				break;

			}

		}

	}


	}
}

